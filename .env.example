# =============================================================
# .env.example — IMS Modular Monolith
# =============================================================
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
#
# ATENÇÃO: nunca versionar o .env com credenciais reais.
# =============================================================

# ── App ──────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
APP_PORT=8080

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=ims_db
POSTGRES_USER=ims
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_USER=ims
RABBITMQ_PASSWORD=change_me_rabbit
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_jwt_secret_min_32_chars_long!!
JWT_ISSUER=IMS.Modular
JWT_AUDIENCE=IMS.Client

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana
GRAFANA_PORT=3000

# ── Jaeger (Observability — US-027) ──────────────────────────
JAEGER_UI_PORT=16686

# ── Backup & Disaster Recovery (US-081) ──────────────────────
# Used by the `backup` profile in docker-compose.yml. The compose service
# maps these BACKUP_* vars onto the variable names expected by
# scripts/backup-postgres.sh / scripts/restore-postgres.sh
# (S3_BUCKET, S3_PREFIX, AWS_*, RETENTION_*).
#
# S3-compatible bucket (AWS S3, MinIO, R2, Wasabi, etc.)
BACKUP_S3_BUCKET=ims-backups
BACKUP_S3_PREFIX=postgres
# Optional. Leave empty for AWS S3; set for MinIO/R2/etc.
# Example MinIO local: http://minio:9000
BACKUP_S3_ENDPOINT_URL=

# Credentials with read+write+delete on $BACKUP_S3_BUCKET/$BACKUP_S3_PREFIX
# Falls back to AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY if unset.
BACKUP_AWS_ACCESS_KEY_ID=change_me_aws_key
BACKUP_AWS_SECRET_ACCESS_KEY=change_me_aws_secret
BACKUP_AWS_REGION=us-east-1

# Retention policy (number of dumps to keep per tier)
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
